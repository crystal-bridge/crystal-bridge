{
  "name": "Gmail",
  "icon": "mail",
  "schedule": {
    "cron": "*/15 * * * *",
    "timezone": "UTC"
  },
  "collect": {
    "command": ["node", "collect.mjs"],
    "timeoutSeconds": 600
  },
  "synthesize": {
    "prompt": "synthesize.md",
    "when": "now",
    "maxBudgetUsd": 1
  },
  "view": "list",
  "summary": [{ "label": "Unread", "field": "unread", "icon": "envelope", "tone": "orange" }],
  "groups": {
    "Primary": { "icon": "star", "tone": "violet" },
    "Updates": { "icon": "bell", "tone": "sky" },
    "Social": { "icon": "users", "tone": "emerald" },
    "Forums": { "icon": "chat", "tone": "teal" },
    "Promotions": { "icon": "tag", "tone": "fuchsia" }
  },
  "show": { "who": "from", "whoKey": "fromAddress", "when": "date", "unread": "unread", "preview": "body" },
  "actions": {
    "open": {
      "kind": "link",
      "label": "Open",
      "url": "{{url}}"
    },
    "follow-up": {
      "kind": "quest",
      "label": "Follow up",
      "project": "~",
      "prompt": "follow-up.md"
    },
    "archive": {
      "kind": "run",
      "label": "Archive",
      "command": ["node", "act.mjs"],
      "batch": true,
      "then": "done"
    },
    "filter": {
      "kind": "run",
      "label": "Filter sender",
      "command": ["node", "act.mjs"],
      "batch": true,
      "confirm": true,
      "then": "done"
    },
    "spam": {
      "kind": "run",
      "label": "Spam",
      "command": ["node", "act.mjs"],
      "batch": true,
      "confirm": true,
      "then": "dismiss"
    },
    "later": {
      "kind": "snooze",
      "label": "Later",
      "for": "1d"
    },
    "done": {
      "kind": "done",
      "label": "Done"
    }
  },
  "defaults": ["open", "later", "done"]
}
