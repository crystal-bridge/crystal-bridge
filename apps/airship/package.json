{
  "name": "@crystal-bridge/airship",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crystal-bridge/crystal-bridge.git"
  },
  "type": "module",
  "bin": {
    "crystal-bridge-airship": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts --dev",
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "node:add": "tsx src/nodes-cli.ts add",
    "node:list": "tsx src/nodes-cli.ts list",
    "token:add": "tsx src/tokens-cli.ts add",
    "token:list": "tsx src/tokens-cli.ts list",
    "token:remove": "tsx src/tokens-cli.ts remove",
    "backup": "tsx src/backup-cli.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crystal-bridge/protocol": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
