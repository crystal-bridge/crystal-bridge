# ~/.config/crystal-bridge/crystal.env (mode 0600) on each node. The deploy scripts write it: they issue the token,
# fill in the hub URL, node id and PATH, and keep the optional lines below across deploys. See README "Configuration".
CRYSTAL_HUB=wss://hub-host.example.ts.net/node
CRYSTAL_NODE=node-a
# Issued by the first deploy (scripts/airship-node-add.sh); never commit a real one.
CRYSTAL_TOKEN=
CRYSTAL_DEFAULT_MODE=auto
# macOS only: the deploy script uses 7711 so it doesn't clash with `pnpm dev` on 7701.
#CRYSTAL_MCP_PORT=7711
# Start every session with Claude in Chrome (Chrome with the extension signed in on this machine).
#CRYSTAL_CHROME=1
# Offer the interactive engine (preview) alongside the default stream engine.
#CRYSTAL_ENGINES=stream,interactive
# Where the New Quest picker looks for repos, colon-separated.
#CRYSTAL_PROJECT_ROOTS=/home/me/code
