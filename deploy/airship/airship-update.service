[Unit]
Description=Crystal Bridge Airship: install the release the hub asked for
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/crystal-bridge/airship.env
Environment=AIRSHIP_UPDATE_REQUEST=/var/lib/airship/update-request.json
# The release it installs is checked first: this project's release workflow at that version's tag, and newer than what
# runs (docs/SECURITY-MODEL.md). Root, because the hub's own user can't write the code it runs or restart itself.
ExecStart=/opt/crystal-bridge/current/node_modules/.bin/crystal-bridge-airship apply-update
TimeoutStartSec=15min

# It writes only the releases and its status beside the request.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/opt/crystal-bridge /var/lib/airship
