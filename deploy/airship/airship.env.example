# /etc/crystal-bridge/airship.env (mode 0640, root:airship). See docs/CONFIGURATION.md.
AIRSHIP_PORT=7700
AIRSHIP_DB=/var/lib/airship/airship.db
# Node tokens (required: the hub won't start without them): add one per Kingdom with
# scripts/airship-node-add.sh <host> <node-id>.
AIRSHIP_NODES=/var/lib/airship/nodes.json
# How the hub knows who a request is from. Left unset, an allow list below means tailscale-serve.
# token is the hub's own login: add one with `pnpm --filter @crystal-bridge/airship token:add <name>`.
#AIRSHIP_AUTH=tailscale-serve
#AIRSHIP_TOKENS=/var/lib/airship/access-tokens.json
# Tailnet logins allowed to use the web app and API, comma-separated (required: the hub won't start open).
AIRSHIP_ALLOWED_USERS=
# Web Push keys, made on first start (default: next to AIRSHIP_DB). Losing them means re-enabling push per device.
#AIRSHIP_VAPID_PATH=/var/lib/airship/vapid.json
# The hub asks npm's registry for the latest Claude Code version every six hours; off stops that.
#AIRSHIP_CLI_CHECK=off
# Contact URL push services may use (mailto: or https:).
#AIRSHIP_PUSH_SUBJECT=
AIRSHIP_BACKUP_DIR=/var/lib/airship/backups
AIRSHIP_BACKUP_KEEP=14
# Off-box copy of the backups (user@host), set by scripts/airship-offsite-setup.sh. Empty keeps them local.
AIRSHIP_BACKUP_SSH=
